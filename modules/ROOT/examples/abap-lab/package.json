{
  "name": "abap-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Local ABAP playground (open-abap). Community software, not SAP software.",
  "scripts": {
    "transpile": "abap_transpile abap_transpile.json",
    "test": "npm run transpile && node output/index.mjs",
    "run:hello": "npm run transpile && node output/project/zhello.prog.mjs",
    "run:first": "npm run transpile && node output/project/zfirst_program.prog.mjs",
    "run:summary": "npm run transpile && node output/project/zdt_summary.prog.mjs",
    "run:items": "npm run transpile && node output/project/zit_internal_tables.prog.mjs",
    "run:claims": "npm run transpile && node output/project/zoo_claims_report.prog.mjs",
    "run:sql": "npm run transpile && node output/project/zsql_claims.prog.mjs",
    "lint": "abaplint abaplint.json",
    "lint:demo": "abaplint lint-demo/abaplint.json"
  },
  "devDependencies": {
    "@abaplint/cli": "2.120.103",
    "@abaplint/database-sqlite": "2.14.12",
    "@abaplint/runtime": "2.14.30",
    "@abaplint/transpiler-cli": "2.14.30"
  },
  "engines": {
    "node": ">=22.12"
  }
}
