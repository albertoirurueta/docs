<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
    controllerName="guide.claims.controller.Main">
  <Page title="Claims">
    <List id="claims" items="{/claims}">
      <ObjectListItem title="{title}" number="{amount}" numberUnit="EUR"/>
    </List>
    <footer>
      <Toolbar>
        <Text id="total"/>
        <ToolbarSpacer/>
        <Button id="totalButton" text="Total" press=".onTotal"/>
      </Toolbar>
    </footer>
  </Page>
</mvc:View>
