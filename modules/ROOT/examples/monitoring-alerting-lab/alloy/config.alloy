// Traces: OTLP from Bookshelf to Tempo. Logs: the JSON log file is tailed into Loki.
otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.batch.default.input]
    logs   = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  // Logs that arrive over OTLP are not forwarded: the tailed file below is the source of truth for Loki.
  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
    tls {
      insecure = true
    }
  }
}

local.file_match "bookshelf" {
  path_targets = [{"__path__" = "/logs/bookshelf.log", "application" = "bookshelf", "job" = "bookshelf"}]
}

loki.source.file "bookshelf" {
  targets    = local.file_match.bookshelf.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
