{
  "title": "Bookshelf service health",
  "description": "RED overview of the Bookshelf service (lab)",
  "time_range": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh_interval": {
    "pause": false,
    "value": 30000
  },
  "query": {
    "language": "kql",
    "expression": ""
  },
  "pinned_panels": [
    {
      "type": "options_list_control",
      "width": "medium",
      "grow": false,
      "config": {
        "title": "Service",
        "data_view_id": "bookshelf-traces",
        "field_name": "service.name"
      }
    }
  ],
  "panels": [
    {
      "grid": {
        "x": 0,
        "y": 0,
        "w": 48,
        "h": 4
      },
      "type": "markdown",
      "config": {
        "content": "## Bookshelf service health\n\nGolden signals from traces and logs. Alert thresholds: 5xx ratio 0.05, p95 0.5 s. Runbook: https://wiki.example.com/bookshelf/runbooks"
      }
    },
    {
      "grid": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "type": "vis",
      "config": {
        "type": "metric",
        "title": "Requests",
        "data_source": {
          "type": "esql",
          "query": "FROM traces-* | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND service.name == \"bookshelf\" | STATS requests = COUNT(*)"
        },
        "metrics": [
          {
            "type": "primary",
            "column": "requests"
          }
        ]
      }
    },
    {
      "grid": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "type": "vis",
      "config": {
        "type": "metric",
        "title": "5xx ratio",
        "data_source": {
          "type": "esql",
          "query": "FROM traces-* | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND service.name == \"bookshelf\" | STATS errors = COUNT(*) WHERE http.response.status_code >= 500, total = COUNT(*) | EVAL ratio = TO_DOUBLE(errors) / total | KEEP ratio"
        },
        "metrics": [
          {
            "type": "primary",
            "column": "ratio"
          }
        ]
      }
    },
    {
      "grid": {
        "x": 24,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "type": "vis",
      "config": {
        "type": "metric",
        "title": "p95 latency (s)",
        "data_source": {
          "type": "esql",
          "query": "FROM traces-* | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND service.name == \"bookshelf\" | STATS p95 = PERCENTILE(duration, 95) | EVAL p95_s = p95 / 1000000000.0 | KEEP p95_s"
        },
        "metrics": [
          {
            "type": "primary",
            "column": "p95_s"
          }
        ]
      }
    },
    {
      "grid": {
        "x": 36,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "type": "vis",
      "config": {
        "type": "metric",
        "title": "ERROR log lines",
        "data_source": {
          "type": "esql",
          "query": "FROM logs-* | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND service.name == \"bookshelf\" AND severity_text == \"ERROR\" | STATS error_lines = COUNT(*)"
        },
        "metrics": [
          {
            "type": "primary",
            "column": "error_lines"
          }
        ]
      }
    },
    {
      "grid": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 12
      },
      "type": "vis",
      "config": {
        "type": "xy",
        "title": "Requests over time",
        "layers": [
          {
            "type": "line",
            "data_source": {
              "type": "esql",
              "query": "FROM traces-* | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND service.name == \"bookshelf\" | STATS requests = COUNT() BY BUCKET(@timestamp, 75, ?_tstart, ?_tend)"
            },
            "x": {
              "column": "BUCKET(@timestamp, 75, ?_tstart, ?_tend)"
            },
            "y": [
              {
                "column": "requests"
              }
            ]
          }
        ],
        "axis": {
          "x": {
            "title": {
              "visible": false
            }
          }
        }
      }
    },
    {
      "grid": {
        "x": 24,
        "y": 10,
        "w": 24,
        "h": 12
      },
      "type": "vis",
      "config": {
        "type": "xy",
        "title": "5xx responses over time",
        "layers": [
          {
            "type": "line",
            "data_source": {
              "type": "esql",
              "query": "FROM traces-* | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND service.name == \"bookshelf\" AND http.response.status_code >= 500 | STATS errors = COUNT() BY BUCKET(@timestamp, 75, ?_tstart, ?_tend)"
            },
            "x": {
              "column": "BUCKET(@timestamp, 75, ?_tstart, ?_tend)"
            },
            "y": [
              {
                "column": "errors"
              }
            ]
          }
        ],
        "axis": {
          "x": {
            "title": {
              "visible": false
            }
          }
        }
      }
    },
    {
      "title": "Dependencies",
      "collapsed": true,
      "grid": {
        "y": 22
      },
      "panels": [
        {
          "grid": {
            "x": 0,
            "y": 0,
            "w": 24,
            "h": 8
          },
          "type": "markdown",
          "config": {
            "content": "JVM heap and connection pool panels go here. The lab stand-in exports no metrics to Elasticsearch."
          }
        }
      ]
    }
  ]
}
