<script id="site-script" src="{{{uiRootPath}}}/js/site.js" data-ui-root-path="{{{uiRootPath}}}"></script>
<script async src="{{{uiRootPath}}}/js/vendor/highlight.js"></script>
{{#if env.SITE_SEARCH_PROVIDER}}
{{> search-scripts}}
{{/if}}
{{!-- Pagefind search UI: deferred so it never blocks the page; initialised once the deferred script has run.
  Pagefind indexes meta.image relative to the indexed page. Pagefind UI 1.6.0 resolves it against meta.url || url only
  in its plain result component; the sub-results component used with showSubResults: true skips that, so the image
  broke when searching from a page at a different depth (#396). processResult does the same resolution; drop it once
  Pagefind UI resolves images there too, or if showSubResults is removed. --}}
<script defer src="{{{siteRootPath}}}/pagefind/pagefind-ui.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var el = document.getElementById('search')
    if (!el || typeof PagefindUI === 'undefined') return
    new PagefindUI({
      element: '#search',
      showSubResults: true,
      processResult: function (result) {
        try {
          var meta = result && result.meta
          var image = meta && meta.image
          if (image && !/^([a-z][a-z0-9+.-]*:|\/)/i.test(image)) {
            meta.image = new URL(image, new URL(meta.url || result.url, location.href)).pathname
          }
        } catch (e) { /* leave the image as is; never break the search */ }
        return result
      },
    })
    el.classList.add('is-ready')
  })
</script>
