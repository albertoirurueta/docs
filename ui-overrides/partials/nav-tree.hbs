{{!--
  Override of the nav-tree partial of ui-bundle.zip (the original is unchanged except for the marked lines).
  It renders the top-level navigation groups of every component expanded by default (the top-level list
  is wrapped in an untitled list at depth 0) and, inside the "Open Source Projects" group, the project groups too, so all projects and all guide sections are visible
  without clicking.
  It also emits only the levels a reader needs, so the nav does not repeat the whole subtree of every section in
  every page (that made guide pages over 1 MB). The child list of an entry is rendered only when the entry is at
  depth 0 or 1 (so the groups and the sections are listed), or contains the current page (the nav-contains-current
  helper, ui-overrides/helpers/nav-contains-current.js), or was opened by its parent (an untitled list wrapper or
  "Open Source Projects"). Other subtrees are not in the HTML (and get no toggle button); readers reach them through the section's own link
  (its index page). The bundle's own toggle buttons and the "toggle all" button keep working because they only
  toggle the is-active class that is rendered here. The entries on the path to the current page are rendered with
  is-active, so the ancestors of the current page are open.
--}}
{{#if navigation.length}}
<ul class="nav-list">
  {{#each navigation}}
  {{!-- WP3: expand = children are emitted (and the entry is open): depth 0 or 1, parent asked for open children, or the entry contains the current page --}}
  {{#with (or (or (eq (or ../level 0) 0) (eq (or ../level 0) 1)) (or ../open (nav-contains-current this @root.page.url))) as |expand|}}{{/with}}
  <li class="nav-item{{#if (eq ./url @root.page.url)}} is-current-page{{/if}}{{#if (or (eq (or ../level 0) 0) (or ../open (nav-contains-current this @root.page.url)))}} is-active{{/if}}" data-depth="{{or ../level 0}}">
    {{#if ./content}}
    {{#if (and ./items.length (or (or (eq (or ../level 0) 0) (eq (or ../level 0) 1)) (or ../open (nav-contains-current this @root.page.url))))}}
    <button class="nav-item-toggle"></button>
    {{/if}}
    {{#if ./url}}
    <a class="nav-link" href="
      {{~#if (eq ./urlType 'internal')}}{{{relativize ./url}}}
      {{~else}}{{{./url}}}{{~/if}}">{{{./content}}}</a>
    {{else}}
    <span class="nav-text">{{{./content}}}</span>
    {{/if}}
    {{/if}}
{{!-- WP2: open the children of an untitled list wrapper (the top-level groups) and of "Open Source Projects" (its project groups) --}}
{{!-- WP3: emit the child list only when needed (see the header comment) --}}
{{#if (or (or (eq (or ../level 0) 0) (eq (or ../level 0) 1)) (or ../open (nav-contains-current this @root.page.url)))}}
{{> nav-tree navigation=./items level=(increment ../level) open=(or (not ./content) (eq ./content 'Open Source Projects'))}}
{{/if}}
  </li>
  {{/each}}
</ul>
{{/if}}
