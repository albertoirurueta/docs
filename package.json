{
  "scripts": {
    "validate:mermaid": "node scripts/validate-mermaid.mjs",
    "charts": "node scripts/language-charts/generate-charts.mjs",
    "tables": "node scripts/language-charts/generate-tables.mjs",
    "test:charts": "node --test \"scripts/language-charts/*.test.mjs\"",
    "charts:docs-tools": "node scripts/documentation-tools-charts/generate-charts.mjs",
    "test:charts:docs-tools": "node --test \"scripts/documentation-tools-charts/*.test.mjs\"",
    "charts:cloud-comparison": "node scripts/cloud-comparison-charts/generate-charts.mjs",
    "test:charts:cloud-comparison": "node --test \"scripts/cloud-comparison-charts/*.test.mjs\"",
    "charts:ecommerce-comparison": "node scripts/ecommerce-comparison-charts/generate-charts.mjs",
    "test:charts:ecommerce-comparison": "node --test \"scripts/ecommerce-comparison-charts/*.test.mjs\"",
    "charts:cms-comparison": "node scripts/cms-comparison-charts/generate-charts.mjs",
    "test:charts:cms-comparison": "node --test \"scripts/cms-comparison-charts/*.test.mjs\"",
    "charts:frameworks": "node scripts/framework-charts/generate-charts.mjs && node scripts/framework-charts/generate-tables.mjs",
    "test:charts:frameworks": "node --test \"scripts/framework-charts/*.test.mjs\""
  },
  "dependencies": {
    "@antora/lunr-extension": "^1.0.0-alpha.13",
    "@djencks/asciidoctor-mathjax": "^0.0.9",
    "@sntke/antora-mermaid-extension": "^0.0.13"
  },
  "devDependencies": {
    "antora": "3.1.15"
  }
}
